# Copiar a jenkins/.env (ignorado por Git), nunca versionar contraseñas

# Pegar una clave SSH PUBLICA completa creada exclusivamente para el agente

JENKINS_AGENT_SSH_PUBKEY=PEGAR_CLAVE_PUBLICA_SSH_COMPLETA

# Elegir dos contraseñas locales distintas y robustas para PostgreSQL de CI

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_POR_SECRETO_LOCAL
CI_PASSWORD=CAMBIAR_POR_SECRETO_LOCAL